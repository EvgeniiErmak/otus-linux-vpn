auth = "plain[passwd=/etc/ocserv/ocpasswd]"
tcp-port = 443
udp-port = 443
run-as-user = nobody
run-as-group = daemon
socket-file = /run/ocserv-socket
server-cert = /etc/ocserv/ssl/server-cert.pem
server-key = /etc/ocserv/ssl/server-key.pem
isolate-workers = false
max-clients = 16
max-same-clients = 2
max-ban-score = 0
keepalive = 32400
dpd = 90
mobile-dpd = 1800
try-mtu-discovery = true
tls-priorities = "NORMAL:%SERVER_PRECEDENCE:%COMPAT:-VERS-SSL3.0"
auth-timeout = 240
min-reauth-time = 300
cookie-timeout = 300
deny-roaming = false
rekey-time = 172800
rekey-method = ssl
use-occtl = true
pid-file = /run/ocserv.pid
device = vpns
predictable-ips = true
default-domain = ocserv.loc
ipv4-network = {{ vpn_network }}
ipv4-netmask = 255.255.255.0
ping-leases = false
# split tunnel: клиенту пушится только сеть VPN
route = {{ vpn_network }}/255.255.255.0
